# Bengal Remedies - Environment Configuration

# Environment mode: development | testing | production
ENVIRONMENT=development

# Data Mode: synthetic (all data is strictly synthetic fixtures)
DATA_MODE=synthetic

# Database URL: SQLite (default local) or PostgreSQL (production)
DATABASE_URL=sqlite:///./data/pharma.db
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pharma_db

# LLM Provider: mock (default offline) | ollama (local model inference) | hosted (future extension)
LLM_PROVIDER=mock

# Ollama Local Configuration (when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=30.0

# Security & Logging
LOG_LEVEL=INFO
ENABLE_SIMULATED_APPROVALS=true
